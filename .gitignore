# Byte-compiled / optimized / cached Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage artifacts
.pytest_cache/
.tox/
.coverage
htmlcov/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local environment / secrets — never commit these
.env
*.key
*.keypair.json

# --- xete estate secret hygiene (2026-07-31, gitignore-estate) ---
# Globs, deliberately NOT exact basenames: two real ed25519 private keys sat
# untracked-and-unignored in a public repo root because the rule was the exact
# name "identity.json". Backstopped by .githooks/pre-push.
*identity*.json
*keypair*.json
*.pem
id_ed25519*
id_rsa*
.env.*
*SEEDPHRASE*
*CREDENTIALS*
*.xete*
Usersjshed*
*.pkl
!.env.example
!.env.sample
!.env.template
# --- end xete estate secret hygiene ---
